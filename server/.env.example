# FoodWise server settings. Copy to `.env` (and `.env.test` for the tests, pointing at
# food_saver_test_db) and fill in your own values. Never commit the copies.
# An empty value counts as not set. See README.md and docs/backend.md for details.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_saver_db
# Secret that signs the login tokens; use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- Server -----------------------------------------------------------------

# API port (default 3000).
PORT=3000
# `production` makes the auth cookie secure and turns on the production-only rules.
NODE_ENV=development
# Frontend origin(s) allowed by CORS and the origin check; a comma-separated list is allowed.
# The first one is also the base of the links in emails.
CLIENT_ORIGIN=http://localhost:5173
# Number of proxies in front of the server (0 or unset locally, 1 on Render).
TRUST_PROXY=
# Business time zone for CURRENT_DATE, expiry and the scheduled jobs.
APP_TIMEZONE=Europe/Sarajevo
# Folder for uploaded logos, covers and product images (default `uploads`).
UPLOADS_DIR=
# `true` turns the rate limiters off. Only for the e2e server, never on a deployment.
DISABLE_RATE_LIMITS=

# --- Email ------------------------------------------------------------------

# `log` (default: printed to the console), `smtp` (Mailpit locally, see docker-compose.yml) or `resend`.
EMAIL_PROVIDER=log
# Sender; required for `resend`. Default `FoodWise <no-reply@foodwise.local>`.
EMAIL_FROM=
# Sends every email to this address instead (required for `resend` outside production).
EMAIL_REDIRECT_TO=
# Resend API key, for EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# SMTP server for EMAIL_PROVIDER=smtp (default localhost:1025, Mailpit).
SMTP_HOST=
SMTP_PORT=

# --- Delivery ---------------------------------------------------------------

# Delivery provider: only `mock` (the default) for now.
DELIVERY_PROVIDER=mock
# Shared secret of the delivery webhook signatures, at least 16 characters.
# Required in production; without it the mock uses a built-in development secret.
DELIVERY_WEBHOOK_SECRET=
